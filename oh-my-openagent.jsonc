{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  // Kimi K3 + Kimi K2.7 + MiniMax M2.7/M3 optimized configuration
  // Fast utility tasks via MiniMax, critical reasoning/visual via K3, balanced deep work via K2.7
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      400,
      402,
      408,
      429,
      500,
      502,
      503,
      504,
      529
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "agents": {
    // Main orchestrator: fast, smart, cheap delegation
    "sisyphus": {
      "model": "minimax/MiniMax-M3",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 32000
      },
      "fallback_models": [
        "kimi-for-coding/k3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    // Deep autonomous worker: K3 for long-horizon implementation
    "hephaestus": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    // Architecture consultant: K3 for hard debugging
    "oracle": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    // Documentation and code search
    "librarian": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    // Fast codebase exploration
    "explore": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    // Visual tasks: UI/UX, images, diagrams
    "multimodal-looker": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    // Strategic planner: K3 for big decisions
    "prometheus": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    // Plan consultant: K2.7 for deliberative review
    "metis": {
      "model": "kimi-for-coding/kimi-for-coding",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3",
        "minimax/MiniMax-M3",
      ]
    },
    // Critic and reviewer: K2.7 for balanced critique
    "momus": {
      "model": "kimi-for-coding/kimi-for-coding",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3",
        "minimax/MiniMax-M3",
      ]
    },
    // Continuation and long-running task handler
    "atlas": {
      "model": "minimax/MiniMax-M3",
      "fallback_models": [
        "kimi-for-coding/k3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    // Lightweight task executor for simple jobs
    "sisyphus-junior": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    }
  },
  "categories": {
    // Fast utility tasks
    "quick": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    "fix": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    "search": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    "test": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    // Documentation and prose
    "writing": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    "explain": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    // Deep reasoning tasks
    "refactor": {
      "model": "kimi-for-coding/kimi-for-coding",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3",
        "minimax/MiniMax-M3",
      ]
    },
    "deep": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    "ultrabrain": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    "visual-engineering": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/kimi-for-coding",
        "minimax/MiniMax-M3",
      ]
    },
    "artistry": {
      "model": "kimi-for-coding/kimi-for-coding",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3",
        "minimax/MiniMax-M3",
      ]
    },
    // Fallback categories
    "unspecified-low": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/kimi-for-coding",
      ]
    },
    "unspecified-high": {
      "model": "kimi-for-coding/kimi-for-coding",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3",
        "minimax/MiniMax-M3",
      ]
    }
  }
}
