{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  // Kimi K3-256k + Kimi K2.7 + MiniMax M2.7/M3 optimized configuration
  // Fast utility tasks via MiniMax, critical reasoning via K3-256k, long-horizon/visual via K3 1M, balanced deep work via K2.7
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      400,
      402,
      408,
      429,
      500,
      502,
      503,
      504,
      529
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "agents": {
    // Main orchestrator: fast, smart, cheap delegation
    "sisyphus": {
      "model": "minimax/MiniMax-M3",
      "mode": "primary",
      "displayName": "Sisyphus - ultraworker",
      "thinking": {
        "type": "adaptive"
      },
      "fallback_models": [
        "kimi-for-coding/k3-256k",
        "kimi-for-coding/k2p7",
      ]
    },
    // Deep autonomous worker: K3 1M for long-horizon implementation (keeps full context)
    "hephaestus": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    // Architecture consultant: K3-256k for hard debugging (half quota vs K3 1M)
    "oracle": {
      "model": "kimi-for-coding/k3-256k",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    // Documentation and code search
    "librarian": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    // Fast codebase exploration
    "explore": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    // Visual tasks: UI/UX, images, diagrams
    "multimodal-looker": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    // Strategic planner: K3-256k for big decisions
    "prometheus": {
      "model": "kimi-for-coding/k3-256k",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    // Plan consultant: K2.7 for deliberative review
    "metis": {
      "model": "kimi-for-coding/k2p7",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3-256k",
        "minimax/MiniMax-M3",
      ]
    },
    // Critic and reviewer: K2.7 for balanced critique
    "momus": {
      "model": "kimi-for-coding/k2p7",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3-256k",
        "minimax/MiniMax-M3",
      ]
    },
    // Continuation and long-running task handler
    "atlas": {
      "model": "minimax/MiniMax-M3",
      "fallback_models": [
        "kimi-for-coding/k3-256k",
        "kimi-for-coding/k2p7",
      ]
    },
    // Lightweight task executor for simple jobs
    "sisyphus-junior": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    }
  },
  "categories": {
    // Fast utility tasks
    "quick": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/k2p7",
      ]
    },
    "fix": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/k2p7",
      ]
    },
    "search": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/k2p7",
      ]
    },
    "test": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/k2p7",
      ]
    },
    // Documentation and prose
    "writing": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/k2p7",
      ]
    },
    "explain": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/k2p7",
      ]
    },
    // Deep reasoning tasks
    "refactor": {
      "model": "kimi-for-coding/k2p7",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3-256k",
        "minimax/MiniMax-M3",
      ]
    },
    // Long-horizon autonomous work: K3 1M (deep tasks can exceed 256k)
    "deep": {
      "model": "kimi-for-coding/k3",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    "ultrabrain": {
      "model": "kimi-for-coding/k3-256k",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    "visual-engineering": {
      "model": "kimi-for-coding/k3-256k",
      "variant": "max",
      "fallback_models": [
        "kimi-for-coding/k2p7",
        "minimax/MiniMax-M3",
      ]
    },
    "artistry": {
      "model": "kimi-for-coding/k2p7",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3-256k",
        "minimax/MiniMax-M3",
      ]
    },
    // Fallback categories
    "unspecified-low": {
      "model": "minimax/MiniMax-M2.7-highspeed",
      "thinking": {
        "type": "disabled"
      },
      "fallback_models": [
        "minimax/MiniMax-M3",
        "kimi-for-coding/k2p7",
      ]
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p7",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "kimi-for-coding/k3-256k",
        "minimax/MiniMax-M3",
      ]
    }
  }
}
