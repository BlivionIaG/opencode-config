// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        400,
        402,
        408,
        429,
        500,
        502,
        503,
        504,
        529
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60,
      "timeout_seconds": 30,
      "notify_on_fallback": true
    },
    "agents": {
      "sisyphus": {
        "mode": "primary",
        "displayName": "Sisyphus - ultraworker",
        "model": "openrouter/minimax/minimax-m3",
        "reasoning": "auto",
        "fallback_models": [
          "openrouter/deepseek/deepseek-v4-flash-vision-exp"
        ]
      },
      "hephaestus": {
        "model": "openrouter/openai/gpt-5.6-sol",
        "fallback_models": [
          "kimi-for-coding/k3",
          "openrouter/deepseek/deepseek-v4-pro-0813",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "oracle": {
        "model": "kimi-for-coding/k3",
        "fallback_models": [
          "openrouter/deepseek/deepseek-v4-pro-0813",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "librarian": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "explore": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "multimodal-looker": {
        "model": "kimi-for-coding/k3-256k",
        "fallback_models": [
          "openrouter/z-ai/glm-5.3",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "prometheus": {
        "model": "kimi-for-coding/k3",
        "fallback_models": [
          "openrouter/deepseek/deepseek-v4-pro-0813",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "metis": {
        "model": "kimi-for-coding/k3-256k",
        "fallback_models": [
          "openrouter/z-ai/glm-5.3",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "momus": {
        "model": "kimi-for-coding/k3-256k",
        "fallback_models": [
          "openrouter/z-ai/glm-5.3",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "atlas": {
        "model": "openrouter/qwen/qwen3.8-max",
        "fallback_models": [
          "openrouter/minimax/minimax-m3"
        ]
      },
      "sisyphus-junior": {
        "model": "openrouter/deepseek/deepseek-v4-flash-vision-exp",
        "reasoning": "auto",
        "fallback_models": [
          "openrouter/minimax/minimax-m3"
        ]
      }
    },
    "categories": {
      "quick": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "fix": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "search": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "test": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "writing": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "explain": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "refactor": {
        "model": "kimi-for-coding/k3-256k",
        "fallback_models": [
          "openrouter/z-ai/glm-5.3",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "deep": {
        "model": "kimi-for-coding/k3",
        "fallback_models": [
          "openrouter/deepseek/deepseek-v4-pro-0813",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "ultrabrain": {
        "model": "kimi-for-coding/k3",
        "fallback_models": [
          "openrouter/deepseek/deepseek-v4-pro-0813",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "visual-engineering": {
        "model": "kimi-for-coding/k3-256k",
        "fallback_models": [
          "openrouter/z-ai/glm-5.3",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "artistry": {
        "model": "kimi-for-coding/k3-256k",
        "fallback_models": [
          "openrouter/z-ai/glm-5.3",
          "openrouter/minimax/minimax-m3"
        ]
      },
      "unspecified-low": {
        "model": "openrouter/minimax/minimax-m3",
        "fallback_models": []
      },
      "unspecified-high": {
        "model": "kimi-for-coding/k3-256k",
        "fallback_models": [
          "openrouter/z-ai/glm-5.3",
          "openrouter/minimax/minimax-m3"
        ]
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification",
    "2026-08-agent-models-array-conversion"
  ]
}
