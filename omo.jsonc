          {
            "model": "kimi-for-coding/k3",
            "reasoning": "max"
          },
          "kimi-for-coding/k2p7",
          "minimax/MiniMax-M3"
        ]
      },
      "prometheus": {
        "models": [
          {
            "model": "kimi-for-coding/k3-256k",
            "reasoning": "max"
          },
          "kimi-for-coding/k2p7",
          "minimax/MiniMax-M3"
        ]
      },
      "metis": {
        "models": [
          {
            "model": "kimi-for-coding/k2p7",
            "provider_options": {
              "thinking": {
                "type": "enabled"
              }
            }
          },
          "kimi-for-coding/k3-256k",
          "minimax/MiniMax-M3"
        ]
      },
      "momus": {
        "models": [
          {
            "model": "kimi-for-coding/k2p7",
            "provider_options": {
              "thinking": {
                "type": "enabled"
              }
            }
          },
          "kimi-for-coding/k3-256k",
          "minimax/MiniMax-M3"
        ]
      },
      "atlas": {
        "models": [
          "minimax/MiniMax-M3",
          "kimi-for-coding/k3-256k",
          "kimi-for-coding/k2p7"
        ]
      },
      "sisyphus-junior": {
