// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        400,
        402,
        408,
        429,
        500,
        502,
        503,
        504,
        529
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60,
      "timeout_seconds": 30,
      "notify_on_fallback": true
    },
    "agents": {
      "sisyphus": {
        "mode": "primary",
        "displayName": "Sisyphus - ultraworker",
        "models": [
          {
            "model": "minimax/MiniMax-M3"
          },
          "kimi-for-coding/k3-256k",
          "kimi-for-coding/k2p7"
        ]
      },
      "hephaestus": {
        "models": [
          {
            "model": "kimi-for-coding/k3",
            "reasoning": "max"
          },
          "kimi-for-coding/k2p7",
          "minimax/MiniMax-M3"
        ]
      },
      "oracle": {
        "models": [
          {
            "model": "kimi-for-coding/k3-256k",
            "reasoning": "max"
          },
          "kimi-for-coding/k2p7",
          "minimax/MiniMax-M3"
        ]
      },
      "librarian": {
        "models": [
          {
            "model": "minimax/MiniMax-M2.7-highspeed",
            "reasoning": "off"
          },
          "kimi-for-coding/k2p7",
          "minimax/MiniMax-M3"
        ]
      },
      "explore": {
        "models": [
          {
            "model": "minimax/MiniMax-M2.7-highspeed",
            "reasoning": "off"
          },
          "kimi-for-coding/k2p7",
          "minimax/MiniMax-M3"
        ]
      },
      "multimodal-looker": {
