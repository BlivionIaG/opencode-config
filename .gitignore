# Dependencies
node_modules/
package.json
bun.lock

# Local data directories (e.g. n8n-mcp node DB cache)
data/

# Secrets and credentials (comprehensive patterns)
.env
.env.local
.env.*.local
.env.production
.env.development
**/.env
**/.env.local
**/.env.*

# API keys and tokens (any file containing these)
*secret*
*SECRET*
*credential*
*CREDENTIAL*
*api_key*
*API_KEY*
*apikey*
*APIKEY*
*auth_token*
*AUTH_TOKEN*
*access_token*
*ACCESS_TOKEN*
*private_key*
*PRIVATE_KEY*
*password*
*PASSWORD*
password.txt
secrets.json
credentials.json
*.pem
*.key

# Session files
*.session
.sessions/
session.json

# Cache and logs
.cache/
logs/
*.log

# OMO plugin runtime state (live config lives at ~/.omo/, mirrored here
# only for scripts/sync-omo.sh to find it without re-resolving $HOME)
.omo/

# Local LSP installation decisions (per-machine, not for the repo)
lsp-install-decisions.json

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/settings.json
.vscode/*.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Git itself (allows tracking this file)
# .gitignore