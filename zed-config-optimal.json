{
  // OPTIMAL Zed + OpenCode Setup
  // Uses OpenCode Go models in Zed's assistant + Terminal for full agents
  
  "assistant": {
    "enabled": true,
    "version": "2",
    
    // Use OpenCode Go via OpenAI-compatible endpoint
    "default_model": {
      "provider": "openai",
      "model": "kimi-k2.5"
    },
    
    "providers": {
      "opencode-go": {
        "name": "OpenCode Go",
        "api_url": "https://opencode.ai/zen/go/v1",
        "api_key": "YOUR_OPENCODE_GO_API_KEY_HERE",
        "available_models": [
          {
            "provider": "opencode-go",
            "name": "MiniMax M2.5 (Fast)",
            "model": "minimax-m2.5",
            "max_tokens": 8192
          },
          {
            "provider": "opencode-go", 
            "name": "Kimi K2.5 (Powerful)",
            "model": "kimi-k2.5",
            "max_tokens": 8192
          }
        ]
      }
    }
  },
  
  // Terminal for full OpenCode agent capabilities
  "terminal": {
    "shell": {
      "program": "bash",
      "args": ["-l"]
    },
    "working_directory": "current_project_directory",
    "line_height": "comfortable"
  },
  
  // LSP/Autocompletion - Keep this enabled!
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  },
  
  // UI tweaks
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  
  "file_watcher": true,
  
  // Key bindings
  "bindings": {
    "ctrl-`": "terminal_panel::ToggleFocus",
    "ctrl-alt-o": ["workspace::OpenTerminal", { "working_directory": "current_project_directory" }]
  }
}
