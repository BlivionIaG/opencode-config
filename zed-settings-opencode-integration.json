{
  // Zed Settings for OpenCode Agent Integration
  
  "assistant": {
    "enabled": true,
    "version": "2",
    
    // Use OpenCode's models via OpenAI-compatible endpoints
    "default_model": {
      "provider": "openai",  // We'll configure custom endpoint
      "model": "kimi-k2.5"
    },
    
    // OpenAI-compatible providers for your models
    "providers": {
      // Option 1: Use OpenCode Go (MiniMax) via OpenAI-compatible endpoint
      "opencode-go": {
        "name": "OpenCode Go",
        "api_url": "https://opencode.ai/zen/go/v1",
        "available_models": [
          {
            "name": "MiniMax M2.5",
            "model": "minimax-m2.5",
            "max_tokens": 8192
          },
          {
            "name": "MiniMax M2.7", 
            "model": "minimax-m2.7",
            "max_tokens": 8192
          },
          {
            "name": "Kimi K2.5",
            "model": "kimi-k2.5",
            "max_tokens": 8192
          },
          {
            "name": "GLM-5",
            "model": "glm-5",
            "max_tokens": 8192
          }
        ]
      }
    }
  },
  
  "terminal": {
    "shell": {
      "program": "bash"
    }
  },
  
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/.opencode",
    "**/.hive"
  ],
  
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  
  "file_watcher": true
}
