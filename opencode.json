{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "chenco": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Chenco",
      "options": {
        "baseURL": "https://litellm.chenco.dev/v1",
        "apiKey": "{env:CHENCO_API_KEY}"
      },
      "models": {
        "qwen3.6-instruct": {
          "name": "Qwen3.6 Instruct"
        },
        "qwen3.6-coding": {
          "name": "Qwen3.6 Coding"
        },
        "qwen3.6-agent": {
          "name": "Qwen3.6 Agent"
        },
        "qwen3.6-vision": {
          "name": "Qwen3.6 Vision"
        }
      }
    },
    "minimax": {
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}"
      },
      "models": {
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax M2.7 Highspeed",
          "family": "minimax",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "release_date": "2026-03-18",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.0000006,
            "output": 0.0000024,
            "cache_read": 0.00000006,
            "cache_write": 0.000000375
          },
          "limit": {
            "context": 204800,
            "output": 131072
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax M3",
          "family": "minimax",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "release_date": "2026-05-31",
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.0000006,
            "output": 0.0000024,
            "cache_read": 0.00000012
          },
          "limit": {
            "context": 512000,
            "output": 65536
          }
        }
      }
    }
  },
  "model": "kimi-for-coding/k2p6",
  "small_model": "minimax/MiniMax-M2.7-highspeed",
  "enabled_providers": [
    "chenco",
    "minimax",
    "kimi-for-coding"
  ],
  "mcp": {
    "n8n-mcp": {
      "type": "local",
      "command": ["npx", "-y", "n8n-mcp"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "MCP_MODE": "stdio",
        "NODE_DB_PATH": "{env:HOME}/.config/opencode/data/n8n-nodes.db",
        "MCP_LOG_LEVEL": "info",
        "N8N_API_URL": "{env:N8N_API_URL}",
        "N8N_API_KEY": "{env:N8N_API_KEY}"
      }
    },
    "koyeb": {
      "type": "local",
      "command": ["npx", "-y", "@koyeb/mcp-server"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "KOYEB_TOKEN": "{env:KOYEB_TOKEN}"
      }
    }
  },
  "plugin": [
    "oh-my-openagent@4.7.5"
  ]
}
