{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "chenco": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Chenco",
      "options": {
        "baseURL": "https://litellm.chenco.dev/v1",
        "apiKey": "{env:CHENCO_API_KEY}"
      },
      "models": {
        "qwen3.6-instruct": {
          "name": "Qwen3.6 Instruct"
        },
        "qwen3.6-coding": {
          "name": "Qwen3.6 Coding"
        },
        "qwen3.6-agent": {
          "name": "Qwen3.6 Agent"
        },
        "qwen3.6-vision": {
          "name": "Qwen3.6 Vision"
        }
      }
    },
    "minimax": {
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}"
      }
    }
  },
  "model": "kimi-for-coding/k2p6",
  "small_model": "minimax/MiniMax-M2.7-highspeed",
  "enabled_providers": [
    "chenco",
    "minimax",
    "kimi-for-coding"
  ],
  "plugin": [
    "oh-my-openagent@latest"
  ]
}
