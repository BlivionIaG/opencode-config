{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "chenco": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Chenco",
      "options": {
        "baseURL": "https://litellm.chenco.dev/v1",
        "apiKey": "{env:CHENCO_API_KEY}"
      },
      "models": {
        "qwen3.6-instruct": {
          "name": "Qwen3.6 Instruct"
        },
        "qwen3.6-coding": {
          "name": "Qwen3.6 Coding"
        },
        "qwen3.6-agent": {
          "name": "Qwen3.6 Agent"
        },
        "qwen3.6-vision": {
          "name": "Qwen3.6 Vision"
        }
      }
    },
    "minimax": {
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}"
      },
      "models": {
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax M2.7 Highspeed",
          "family": "minimax",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "release_date": "2026-03-18",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.0000006,
            "output": 0.0000024,
            "cache_read": 0.00000006,
            "cache_write": 0.000000375
          },
          "limit": {
            "context": 204800,
            "output": 131072
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax M3",
          "family": "minimax",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "release_date": "2026-05-31",
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.0000006,
            "output": 0.0000024,
            "cache_read": 0.00000012
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    },
    "minimax-paygo": {
      "npm": "@ai-sdk/anthropic",
      "name": "MiniMax PayGo",
      "options": {
        "baseURL": "https://api.minimax.io/anthropic/v1",
        "apiKey": "{env:MINIMAX_PAYGO_API_KEY}"
      },
      "models": {
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax M2.7 Highspeed PayGo",
          "family": "minimax",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "release_date": "2026-03-18",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.0000006,
            "output": 0.0000024,
            "cache_read": 0.00000006,
            "cache_write": 0.000000375
          },
          "limit": {
            "context": 204800,
            "output": 131072
