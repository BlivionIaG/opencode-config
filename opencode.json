  "model": "openrouter/minimax/minimax-m3",
  "small_model": "minimax/MiniMax-M2.7-highspeed",
  "enabled_providers": [
    "chenco",
    "minimax",
    "kimi-for-coding",
    "sglang-test",
    "bailian-token-plan-personal",
    "baseten",
    "openrouter"
  ],
  "mcp": {
    "n8n-mcp": {
      "type": "local",
      "command": ["npx", "-y", "n8n-mcp"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "MCP_MODE": "stdio",
        "NODE_DB_PATH": "{env:HOME}/.config/opencode/data/n8n-nodes.db",
        "MCP_LOG_LEVEL": "info",
        "N8N_API_URL": "{env:N8N_API_URL}",
        "N8N_API_KEY": "{env:N8N_API_KEY}"
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "koyeb": {
      "type": "local",
      "command": ["npx", "-y", "@koyeb/mcp-server"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "KOYEB_TOKEN": "{env:KOYEB_TOKEN}"
      }
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  },
  "plugin": [
    "oh-my-openagent@4.19.4"
  ],
  "agent": {
    "vulcan": {
      "description": "Deep autonomous worker (DeepSeek V4 Flash 0731) - long-horizon implementation, large refactors, multi-step goals. Prompt tuned for one task at a time, no premature scaling.",
      "mode": "all",
      "model": "bailian-token-plan-personal/deepseek-v4-flash-0731",
      "fallback_models": [
        "openrouter/deepseek/deepseek-v4-flash-0731",
        "openrouter/minimax/minimax-m3",
        "minimax/MiniMax-M3"
      ],
      "prompt": "{file:./agents/vulcan.md}"
    }
  }
}
