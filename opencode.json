    "baseten",
    "openrouter"
  ],
  "mcp": {
    "discord": {
      "type": "local",
      "command": ["/Users/kletorch/Projects/Infra/discord-mcp/scripts/run-mcp.sh"],
      "enabled": true,
      "timeout": 45000
    },
    "n8n-mcp": {
      "type": "local",
      "command": ["npx", "-y", "n8n-mcp"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "MCP_MODE": "stdio",
        "NODE_DB_PATH": "{env:HOME}/.config/opencode/data/n8n-nodes.db",
        "MCP_LOG_LEVEL": "info",
        "N8N_API_URL": "{env:N8N_API_URL}",
        "N8N_API_KEY": "{env:N8N_API_KEY}"
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "koyeb": {
      "type": "local",
      "command": ["npx", "-y", "@koyeb/mcp-server"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "KOYEB_TOKEN": "{env:KOYEB_TOKEN}"
      }
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    }
  },
