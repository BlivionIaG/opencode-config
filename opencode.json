        },
        "MiniMax-M3": {
          "name": "MiniMax M3 PayGo",
          "family": "minimax",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "release_date": "2026-05-31",
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.0000006,
            "output": 0.0000024,
            "cache_read": 0.00000012
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
