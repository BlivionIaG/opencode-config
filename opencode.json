  "model": "kimi-for-coding/k2p6",
  "small_model": "minimax/MiniMax-M2.7-highspeed",
  "enabled_providers": [
    "chenco",
    "minimax",
    "minimax-paygo",
    "kimi-for-coding"
  ],
  "plugin": [
    "oh-my-openagent@latest"
  ]
}
