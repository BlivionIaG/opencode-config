{
  // OPTIMAL Zed + OpenCode Setup
  // Uses your OpenCode Go subscription (NOT OpenRouter - save those credits!)
  
  "assistant": {
    "enabled": true,
    "version": "2",
    
    // Default: Fast MiniMax for inline help
    "default_model": {
      "provider": "opencode-go",
      "model": "minimax-m2.5"
    },
    
    // Your OpenCode Go models
    "providers": {
      "opencode-go": {
        "name": "OpenCode Go",
        "api_url": "https://opencode.ai/zen/go/v1",
        "api_key": "PASTE_YOUR_OPENCODE_GO_KEY_HERE",
        "available_models": [
          {
            "provider": "opencode-go",
            "name": "MiniMax M2.5 (Fast & Cheap)",
            "model": "minimax-m2.5",
            "max_tokens": 4096
          },
          {
            "provider": "opencode-go",
            "name": "Kimi K2.5 (Powerful)",
            "model": "kimi-k2.5",
            "max_tokens": 8192
          }
        ]
      }
    }
  },
  
  // Terminal for FULL OpenCode agent capabilities (oh-my-opencode)
  "terminal": {
    "shell": {
      "program": "bash"
    },
    "working_directory": "current_project_directory"
  },
  
  // LSP/Autocompletion - Stays enabled, works independently
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-language-server", "!vtsls"]
    }
  },
  
  "file_watcher": true,
  "autosave": "on_focus_change"
}
